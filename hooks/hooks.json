{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" context", "timeout": 15 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" hint", "timeout": 6 } ] },
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" sense", "timeout": 5, "async": true } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" sense", "timeout": 5, "async": true } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": ".*", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" sense", "timeout": 5, "async": true } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" consolidate --quiet", "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/humona.py\" consolidate --quiet", "timeout": 40 } ] }
    ]
  }
}
